# Baseline shared by both roles: IDF defaults except target, CPU clock and tick rate.

# Target for a fresh sdkconfig; change per preset with: idf.py --preset <name> set-target <chip>
# (needs PCNT for the reference clock: esp32, esp32s3, esp32c6 ... not esp32c3)
CONFIG_IDF_TARGET="esp32s3"

# Ignored on targets without a 240 MHz option (C6 tops out at 160 MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 1 ms tick so that rate=N pacing is not quantized to 10 ms
CONFIG_FREERTOS_HZ=1000
